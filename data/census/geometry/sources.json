  "queryParameters": {
    "censusSubdivisions": {
      "layer": 9,
      "where": "CSDUID LIKE '3518%' OR CSDUID LIKE '3519%' OR CSDUID LIKE '3520%' OR CSDUID LIKE '3521%' OR CSDUID LIKE '3524%'"
    },
    "censusTracts": {
      "layer": 11,
      "where": "1=1",
      "geometry": "-80.15,43.2,-78.2,44.6",
      "geometryType": "esriGeometryEnvelope",
      "inSR": 4326,
      "spatialRel": "esriSpatialRelIntersects",
      "resultRecordCount": 500,
      "resultOffsets": [
        0,
        500,
        1000,
        1500
      ],
      "orderByFields": "CTUID"
    },
    "shared": {
      "f": "geojson",
      "returnGeometry": "true",
      "outFields": "*",
      "outSR": 4326,
      "geometryPrecision": 6
    }
  },
  "selection": "CT polygons assigned by greatest polygon overlap to a GTA CSD. All 1,339 selected CTs lie entirely within their assigned CSD. Scugog, Brock and Mississaugas of Scugog Island have no census tracts and retain complete CSD boundaries.",
